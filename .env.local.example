# Local development defaults
AUTH_SECRET=replace-with-a-long-random-secret
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/chatbot
REDIS_URL=redis://localhost:6379

# Required for AI responses outside Vercel.
AI_GATEWAY_API_KEY=replace-with-your-vercel-ai-gateway-key

# Required for file attachments. Local development still uses Vercel Blob.
BLOB_READ_WRITE_TOKEN=replace-with-your-vercel-blob-token
